{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "ideal-machine-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "AUTH_BASE_URL": "https://ideal-machine-auth.ideal-machine.workers.dev",
    "FRONTEND_URL": "https://qilily740.github.io/111/",
    "ALLOWED_ORIGINS": "https://qilily740.github.io",
    "DISCORD_GUILD_ROLE_REQUIREMENTS": "[{\"guildId\":\"1548614114899796074\",\"roleIds\":[\"1548619622431850506\"]},{\"guildId\":\"1379304008157499423\",\"roleIds\":[\"1379453550161039502\"]}]",
    "DISCORD_REDIRECT_URI": "https://ideal-machine-auth.ideal-machine.workers.dev/auth/discord/callback",
    "DISCORD_OAUTH_AUTHORIZE_URL": "https://discord.com/oauth2/authorize",
    "DISCORD_API_BASE_URL": "https://discord.com/api/v10",
    "DISCORD_ACCESS_TTL_SECONDS": "600"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideal-machine-auth",
      "database_id": "452b85c1-21e5-4af5-9825-e38db6475d13",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
